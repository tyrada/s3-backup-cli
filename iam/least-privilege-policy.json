{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSelectedPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {"s3:prefix": ["BACKUP_PREFIX", "BACKUP_PREFIX/*"]}
      }
    },
    {
      "Sid": "BackupObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/BACKUP_PREFIX/*"
    }
  ]
}
